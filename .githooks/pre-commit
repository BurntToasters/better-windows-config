#!/bin/sh
# Pre-commit gate for Better Windows Config. Enabled via `git config core.hooksPath .githooks`
# (set automatically by `npm install` through the prepare script).
# Bypass with: git commit --no-verify

set -e

# Project rule: no em dashes (U+2014) in any file. Only added lines are checked.
em_dash=$(printf '\342\200\224')
if git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -q "$em_dash"; then
  echo "pre-commit: em dash (U+2014) in staged changes; use a hyphen, colon or comma instead." >&2
  exit 1
fi
