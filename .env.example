# GitHub releases use the GitHub CLI credential store. Run `gh auth login` on
# each release VM; no GitHub token belongs in this file.

# GPG key ID / fingerprint for signing release artifacts
GPG_KEY_ID=

# GPG passphrase for non-interactive signing on a release VM
GPG_PASSPHRASE=

# Updater signing key (minisign secret key). Read by scripts/assemble-bundle.js and
# scripts/sign-update-manifest.js when --secret-key is not given. Accepted values:
#   - base64 of the whole key file, as `tauri signer generate` prints it (the usual form)
#   - the raw minisign key file text
#   - a path to the key file or its folder
# Its public half must be one of the keys in src/Bwc.Update/Signing/TrustedKeys.cs.
TAURI_SIGNING_PRIVATE_KEY=
# Password for an encrypted key. Leave empty only for an unencrypted key.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust)
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Exact signing cert Subject DN (must match the Azure Artifact Signing profile Subject name). Example:
#   AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=CN=Your Name, O=Your Org, C=US
# Tip after a signed build:
#   (Get-AuthenticodeSignature .\BetterWindowsConfig.exe).SignerCertificate.Subject
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0
# Skip building/signing the Win11 modern context-menu package (classic verbs remain).
# SKIP_WIN_CONTEXT_MENU=1
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

# unused by BWC (no macOS build); kept so a Zinnia .env can be copied unchanged.
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
SSH_USER_PWD=

# Mirror the signed release folder to another folder in the finalize step (npm run release:mirror).
# Required for a stable version. The files go to <AFTER_PACK_LOC>/<version>/. Use an absolute path
# outside this repository. A Zinnia .env points at Zinnia's share; change the value for BWC (for
# example Z:/BWC) so the two products do not share version folders.
AFTER_PACK_LOC=Z:/BWC
# Beta versions (X.Y.Z-beta.N) skip the mirror. Set to 1 only to force mirroring for a beta.
# OVERRIDE_BETA_MIRROR_SKIP=

# Override the GitHub repository the release scripts target. Defaults to BurntToasters/better-windows-config.
# Set both, or only the one you change. Empty values count as unset.
# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=better-windows-config
