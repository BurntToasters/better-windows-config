<?xml version='1.0' encoding='utf-8'?>
<policyComments xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/CommentDefinitions">
  <policyNamespaces>
    <using prefix="ns0" namespace="BWC.Policies.Oracle"></using>
  </policyNamespaces>
  <comments>
    <admTemplate>
      <comment policyRef="ns0:Pol_Class_Machine" commentText="$(resource.ns0_Pol_Class_Machine)"></comment>
      <comment policyRef="ns0:Pol_Value_Decimal" commentText="$(resource.ns0_Pol_Value_Decimal)"></comment>
    </admTemplate>
  </comments>
  <resources minRequiredRevision="1.0">
    <stringTable>
      <string id="ns0_Pol_Class_Machine">bwc comment one</string>
      <string id="ns0_Pol_Value_Decimal">bwc comment two</string>
    </stringTable>
  </resources>
</policyComments>