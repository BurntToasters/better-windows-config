<Project Sdk="MSTest.Sdk/4.5.2">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bwc.E2E</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="FlaUI.Core" />
  </ItemGroup>

  <!--
    The stand-in installer for the Hub install test. Only the build order matters: the reference copies no
    assembly. Its build publishes FakeInstaller.exe for each architecture into artifacts/e2e/fake-installer.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bwc.E2E.FakeInstaller\Bwc.E2E.FakeInstaller.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
