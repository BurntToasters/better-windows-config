<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The stand-in installer for the Hub install E2E test. It is never a release artifact: it is not in any
    publish folder and it is not signed by the release key. The E2E fixture signs its bytes with the
    throwaway test key. Each architecture is published as one framework-dependent single-file exe, because
    the helper stages and starts a lone installer.exe with nothing beside it. The outputs are written to
    artifacts/e2e/fake-installer/<rid>/FakeInstaller.exe, where the E2E fixture reads them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bwc.E2E.FakeInstaller</RootNamespace>
    <AssemblyName>FakeInstaller</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Publishes both architectures after the normal build. The nested publish sets BwcStandInInner, so it does
    not publish again. Each publish is a single-file bundle, so the staged file runs with no other file.
  -->
  <Target Name="BwcPublishStandIns" AfterTargets="Build" Condition="'$(BwcStandInInner)' != 'true'">
    <PropertyGroup>
      <BwcStandInOut>$(MSBuildProjectDirectory)\..\..\artifacts\e2e\fake-installer</BwcStandInOut>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="BwcStandInInner=true;Platform=x64;RuntimeIdentifier=win-x64;PublishSingleFile=true;SelfContained=false;PublishDir=$(BwcStandInOut)\win-x64\" />
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="BwcStandInInner=true;Platform=ARM64;RuntimeIdentifier=win-arm64;PublishSingleFile=true;SelfContained=false;PublishDir=$(BwcStandInOut)\win-arm64\" />
  </Target>

</Project>
