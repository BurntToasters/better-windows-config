{
  "name": "better-windows-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "build:win:x64": "node scripts/dotnet-build.js --rid win-x64",
    "build:win:arm64": "node scripts/dotnet-build.js --rid win-arm64",
    "build:win:e2e": "node scripts/dotnet-build.js --rid win-arm64 --flavor e2e",
    "installer:x64": "node scripts/build-installer.js --rid win-x64",
    "installer:arm64": "node scripts/build-installer.js --rid win-arm64",
    "run:hub": "node scripts/run-app.js hub",
    "run:regedit": "node scripts/run-app.js regedit",
    "icons:normalize": "node scripts/normalize-icons.js",
    "sync-version": "node scripts/sync-version.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:all": "node scripts/test-all.js",
    "oracle": "node scripts/oracle.js",
    "gate": "node scripts/test-all.js",
    "validate": "node scripts/validate-no-em-dash.js && node scripts/validate-changelog-version.js && node scripts/lint-comments.mjs",
    "release:dry-run": "node --env-file-if-exists=.env scripts/release-dry-run.js",
    "release:assemble": "node --env-file-if-exists=.env scripts/assemble-bundle.js",
    "release:sign": "node --env-file-if-exists=.env scripts/sign-update-manifest.js",
    "release:validate": "node scripts/validate-updater-manifest.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:session": "node scripts/release-session.js",
    "release:draft": "node --env-file-if-exists=.env scripts/release-draft.js",
    "release:verify": "node --env-file-if-exists=.env scripts/release-verify.js",
    "release:publish": "node --env-file-if-exists=.env scripts/release-publish.js",
    "release:selftest": "node scripts/release-selftest.js",
    "setup:win:artifact-signing": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-artifact-signing.ps1",
    "signing:selftest": "node scripts/artifact-signing-selftest.js"
  }
}
