{
  "name": "better-windows-config",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": "^26.13.1",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "build:win:x64": "node scripts/dotnet-build.js --rid win-x64",
    "build:win:arm64": "node scripts/dotnet-build.js --rid win-arm64",
    "build:win:e2e": "node scripts/dotnet-build.js --rid win-arm64 --flavor e2e",
    "installer:x64": "node --env-file-if-exists=.env scripts/build-installer.js --rid win-x64",
    "installer:arm64": "node --env-file-if-exists=.env scripts/build-installer.js --rid win-arm64",
    "run:hub": "node scripts/run-app.js hub",
    "run:regedit": "node scripts/run-app.js regedit",
    "icons:normalize": "node scripts/normalize-icons.js",
    "sync-version": "node scripts/sync-version.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:installer-e2e": "node scripts/test-installer-e2e.js",
    "test:all": "node scripts/test-all.js",
    "oracle": "node scripts/oracle.js",
    "gate": "node scripts/test-all.js",
    "validate": "node scripts/validate-no-em-dash.js && node scripts/validate-changelog-version.js && node scripts/lint-comments.mjs",
    "release:dry-run": "node --env-file-if-exists=.env scripts/release-dry-run.js",
    "release:assemble": "node --env-file-if-exists=.env scripts/assemble-bundle.js",
    "release:sign": "node --env-file-if-exists=.env scripts/sign-update-manifest.js",
    "release:validate": "node scripts/validate-updater-manifest.js",
    "release:policy": "node --env-file-if-exists=.env scripts/release-policy.js",
    "release:preflight": "node --env-file-if-exists=.env scripts/release-preflight.js",
    "release:session": "node --env-file-if-exists=.env scripts/release-session.js",
    "release:session:create": "node --env-file-if-exists=.env scripts/release-session.js create",
    "release:session:verify": "node --env-file-if-exists=.env scripts/release-session.js verify",
    "release:draft": "node --env-file-if-exists=.env scripts/release-draft.js",
    "release:verify": "node --env-file-if-exists=.env scripts/release-verify.js",
    "release:verify:draft": "node --env-file-if-exists=.env scripts/release-verify.js --apply",
    "release:publish": "node --env-file-if-exists=.env scripts/release-publish.js --apply",
    "release:verify:published": "node --env-file-if-exists=.env scripts/validate-updater-live.js --expected-version=current",
    "release:rehearse:client": "node scripts/updater-client-live.js",
    "release:mirror": "node --env-file-if-exists=.env scripts/finalize-release-assets.js",
    "release:sign:gpg": "node --env-file-if-exists=.env scripts/gpg-sign.js",
    "release:authenticode": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-authenticode.ps1",
    "release:win": "node --env-file-if-exists=.env scripts/run-release.js",
    "release:win:continue": "node --env-file-if-exists=.env scripts/run-release.js --continue",
    "release:win:resume": "npm run prerelease:prepare && npm run release:win:continue",
    "release:win:upload": "node --env-file-if-exists=.env scripts/run-release.js --continue --from release:draft",
    "release:cleanup": "node scripts/release-cleanup.js",
    "prerelease:prepare": "npm run release:policy && npm run release:preflight -- --require-trusted-key",
    "release:selftest": "node scripts/release-selftest.js",
    "release:flow:selftest": "node scripts/run-release-selftest.js",
    "release:assets:selftest": "node scripts/release-assets-selftest.js",
    "release:embed-key": "node --env-file-if-exists=.env scripts/embed-update-key.js",
    "release:embed-key:selftest": "node scripts/embed-update-key-selftest.js",
    "setup:win:artifact-signing": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-artifact-signing.ps1",
    "signing:selftest": "node scripts/artifact-signing-selftest.js"
  }
}
