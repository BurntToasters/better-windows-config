<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bwc.Update</RootNamespace>
    <AssemblyName>BwcUpdate</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NativeAOT in both flavors (update-elevation.md HE5, HN). The elevated helper has no .NET host and no CoreCLR, so a
         profiler, a host trace, or a startup hook that the user's environment names is never read. The publish folder gets
         BwcUpdate.exe and its symbols only: no BwcUpdate.dll, deps.json, or runtimeconfig.json. -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The native symbols (BwcUpdate.pdb, about 30 MB) stay in obj and out of the shared publish folder and the installer. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Kept although a NativeAOT exe has no startup hook provider: harmless, and it keeps the JIT build the same. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <!-- The E2E flavor never elevates. Ship keeps app.manifest, which is also asInvoker: the updater never asks for elevation. -->
  <PropertyGroup Condition="'$(BwcFlavor)' == 'E2E'">
    <ApplicationManifest>app.e2e.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Drop the apphost and manifest outputs that both flavors share when the flavor changes. -->
  <Target Name="BwcDropFlavorManifestOutputs" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BwcFlavorStampFile>$(IntermediateOutputPath)bwc-flavor.txt</BwcFlavorStampFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BwcFlavorStampFile)" Condition="Exists('$(BwcFlavorStampFile)')">
      <Output TaskParameter="Lines" PropertyName="BwcPreviousFlavor" />
    </ReadLinesFromFile>
    <RemoveDir Directories="$(IntermediateOutputPath)Manifests" Condition="'$(BwcPreviousFlavor)' != '$(BwcFlavor)'" />
    <Delete Files="$(IntermediateOutputPath)apphost.exe" Condition="'$(BwcPreviousFlavor)' != '$(BwcFlavor)'" />
    <WriteLinesToFile File="$(BwcFlavorStampFile)" Lines="$(BwcFlavor)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET 10 has no Ed25519 or BLAKE2b in the BCL (see spikes/S5-minisign/README.md). -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bwc.Core\Bwc.Core.csproj" />
  </ItemGroup>

</Project>
