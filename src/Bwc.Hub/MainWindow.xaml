<Window
    x:Class="Bwc.Hub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentControl
        x:Name="HubRoot"
        AutomationProperties.AutomationId="HubRoot"
        AutomationProperties.Name="Better Windows Config"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="ProductTitle"
                    FontFamily="Segoe UI"
                    FontSize="{StaticResource BwcFontSize}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="VersionText"
                    AutomationProperties.AutomationId="HubVersion"
                    FontFamily="Segoe UI"
                    FontSize="{StaticResource BwcFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer
                x:Name="ToolList"
                Grid.Row="1"
                AutomationProperties.AutomationId="ToolList"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel x:Name="ToolRows" Spacing="4" />
            </ScrollViewer>

            <TextBlock
                x:Name="HubStatus"
                Grid.Row="2"
                AutomationProperties.AutomationId="HubStatus"
                FontFamily="Segoe UI"
                FontSize="{StaticResource BwcFontSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="HubAbout"
                Grid.Row="3"
                AutomationProperties.AutomationId="HubAbout"
                FontFamily="Segoe UI"
                FontSize="{StaticResource BwcFontSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>
    </ContentControl>

</Window>
