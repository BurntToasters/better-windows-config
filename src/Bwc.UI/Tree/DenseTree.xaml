<UserControl
    x:Class="Bwc.UI.Tree.DenseTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Bwc.UI.Tree"
    AutomationProperties.AutomationId="TreeControl"
    AutomationProperties.Name="Tree"
    Background="Transparent"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <local:TreeRowElement />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            Padding="0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <Grid>
                <controls:ItemsRepeater
                    x:Name="Repeater"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource RowTemplate}"
                    VerticalAlignment="Top">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="0" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <Canvas
                    x:Name="Overlay"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <TextBox
                        x:Name="RenameBox"
                        AutomationProperties.AutomationId="TreeRenameBox"
                        AutomationProperties.Name="Rename key"
                        AcceptsReturn="False"
                        BorderThickness="1"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        MinHeight="0"
                        MinWidth="0"
                        Padding="0"
                        TextWrapping="NoWrap"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
