<Window
    x:Class="Bwc.UI.Dialogs.ModalDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Bwc.UI.Dialogs">

    <dialogs:DialogRootControl
        x:Name="DialogRoot"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.AutomationId="DialogRoot"
        FontFamily="Segoe UI"
        FontSize="12"
        IsTabStop="False">

        <Grid
            Padding="12"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            RowDefinitions="Auto,Auto,*,Auto,Auto"
            RowSpacing="8">

            <TextBlock
                x:Name="HeadingText"
                Grid.Row="0"
                AutomationProperties.AutomationId="DialogHeading"
                FontFamily="Segoe UI"
                FontSize="12"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="MessageText"
                Grid.Row="1"
                AutomationProperties.AutomationId="DialogMessage"
                FontFamily="Segoe UI"
                FontSize="12"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="DialogBody" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>

            <TextBlock
                x:Name="ValidationText"
                Grid.Row="3"
                AutomationProperties.AutomationId="DialogValidationText"
                FontFamily="Segoe UI"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="PrimaryButton"
                    MinHeight="0"
                    Padding="14,4"
                    AutomationProperties.AutomationId="DialogPrimary"
                    Click="OnPrimaryClick"
                    Content="OK"
                    FontFamily="Segoe UI"
                    FontSize="12" />
                <Button
                    x:Name="SecondaryButton"
                    MinHeight="0"
                    Padding="14,4"
                    AutomationProperties.AutomationId="DialogSecondary"
                    Click="OnSecondaryClick"
                    Content="Cancel"
                    FontFamily="Segoe UI"
                    FontSize="12" />
            </StackPanel>
        </Grid>
    </dialogs:DialogRootControl>
</Window>
