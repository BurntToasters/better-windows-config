<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Classic regedit metrics in DIPs, from docs/parity/oracle/regedit-metrics.json.
        That capture ran at 200% scale (192 DPI), so each pixel value is halved.
    -->
    <x:Double x:Key="BwcFontSize">12</x:Double>
    <x:Double x:Key="BwcTreeRowHeight">17</x:Double>
    <x:Double x:Key="BwcListRowHeight">18</x:Double>
    <x:Double x:Key="BwcHeaderHeight">20</x:Double>
    <x:Double x:Key="BwcMenuBarHeight">19</x:Double>
    <x:Double x:Key="BwcTreeIndent">16</x:Double>

</ResourceDictionary>
