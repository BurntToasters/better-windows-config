<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menu="using:Bwc.UI.Menu">

    <!--
        Classic regedit metrics in DIPs, from docs/parity/oracle/regedit-metrics.json.
        That capture ran at 200% scale (192 DPI), so each pixel value is halved.
        Bwc.UI.Theme.DenseMetrics holds the same defaults; the shell applies the runtime
        values in code so a font change recomputes the row heights.
    -->
    <x:Double x:Key="BwcFontSize">12</x:Double>
    <x:Double x:Key="BwcTreeRowHeight">17</x:Double>
    <x:Double x:Key="BwcListRowHeight">18</x:Double>
    <x:Double x:Key="BwcHeaderHeight">20</x:Double>
    <x:Double x:Key="BwcMenuBarHeight">19</x:Double>
    <x:Double x:Key="BwcTreeIndent">16</x:Double>
    <x:Double x:Key="BwcTreePaneWidth">216</x:Double>

    <!--
        Popup menu metrics in DIPs, from docs/parity/oracle/regedit-menu-metrics.json (measured at
        192 DPI, so 1 DIP is 2 device pixels). Item height 22, separator 6.5 with a 1 px line, a
        33 DIP text column after the check gutter, the accelerator 22.5 DIP from the right edge, and
        the submenu chevron 13.5 DIP from the right edge.
    -->
    <x:Double x:Key="BwcMenuItemHeight">22</x:Double>
    <x:Double x:Key="BwcMenuSeparatorHeight">6.5</x:Double>
    <x:Double x:Key="BwcMenuGutterWidth">33</x:Double>
    <x:Double x:Key="BwcMenuAcceleratorInset">22.5</x:Double>
    <x:Double x:Key="BwcMenuArrowInset">13.5</x:Double>

    <!--
        Palette brushes. Each is a live SolidColorBrush: Bwc.UI.Theme.BwcBrushes looks these keys up
        and BwcTheme writes Color on them, so every element that uses a key changes at once. The
        values here are the light system colors on the reference machine, so the first frame is
        already classic before the palette is applied. Keep the keys in step with BwcBrushes.
    -->
    <SolidColorBrush x:Key="BwcWindowBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BwcWindowTextBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="BwcFaceBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="BwcShadowBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="BwcHighlight3DBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BwcGrayTextBrush" Color="#FF6D6D6D" />
    <SolidColorBrush x:Key="BwcSelectionBrush" Color="#FF0078D4" />
    <SolidColorBrush x:Key="BwcSelectionTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BwcTreeSelectionBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="BwcTreeSelectionTextBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="BwcTreeFocusRectBrush" Color="#00000000" />
    <SolidColorBrush x:Key="BwcListSelectionBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="BwcListSelectionTextBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="BwcListFocusRectBrush" Color="#00000000" />

    <!--
        Menu chrome brushes. They are not palette entries of their own: ClassicMenuBrushes derives
        them from the window, face, and shadow brushes on every theme change, so the light and dark
        menus follow BwcTheme. The values here are the light result for the first frame.
    -->
    <SolidColorBrush x:Key="BwcMenuBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="BwcMenuBorderBrush" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="BwcMenuHighlightBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="BwcMenuSeparatorBrush" Color="#FFD7D7D7" />

    <!--
        Popup shadow. The presenter border is lifted by its translation, so the theme shadow falls on the
        window behind it, which gives the soft edge of a classic popup.
    -->
    <ThemeShadow x:Key="BwcMenuShadow" />

    <!-- Keyed styles: ordinary controls elsewhere keep the Fluent defaults. -->
    <Style x:Key="BwcMenuBarStyle" TargetType="MenuBar">
        <Setter Property="Height" Value="{StaticResource BwcMenuBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="Background" Value="{StaticResource BwcWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
    </Style>

    <!--
        Top-level bar item. The template keeps the structure of the WinUI default, because the control
        looks up its named parts (ContentRoot, Background, ContentButton) to open the flyout. The Fluent
        button had a minimum height that clipped the text in a 19 DIP bar, so the button is sized to the
        bar here. Padding is 7 DIP on each side of the text, which reproduces the oracle rectangles.
    -->
    <Style x:Key="BwcMenuBarItemStyle" TargetType="MenuBarItem">
        <Setter Property="Height" Value="{StaticResource BwcMenuBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuBarItem">
                    <Grid x:Name="ContentRoot" Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <!-- The button stays transparent in every state, as in the WinUI default. -->
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Background"
                            Background="Transparent"
                            BorderThickness="0" />
                        <Button
                            x:Name="ContentButton"
                            Height="{StaticResource BwcMenuBarHeight}"
                            MinHeight="0"
                            MinWidth="0"
                            Padding="0"
                            Margin="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.AccessibilityView="Raw">
                            <menu:MenuLabel
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Label="{TemplateBinding Title}"
                                MnemonicKey="{TemplateBinding AccessKey}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Popup presenter. The WinUI default presenter has a system backdrop and Fluent padding. This template keeps
        the default ScrollViewer and ItemsPresenter, which the flyout needs to show its items, and replaces the
        chrome: a 4 DIP corner radius (about 8 px at 192 DPI, measured on the classic popup), a 1 DIP border (2 px
        at 192 DPI), and the theme shadow. Items sit 1.5 DIP from the edge.
    -->
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource BwcMenuBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BwcMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0.5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsHorizontalRailEnabled" Value="False" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="False" />
        <Setter Property="ScrollViewer.ZoomMode" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutPresenter">
                    <!--
                        The items are not scrolled. A ScrollViewer sized to the popup scrolled the first item out of
                        view, so the items sit directly in the border and the popup grows to fit them.
                    -->
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shadow="{StaticResource BwcMenuShadow}"
                        Translation="0,0,32">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Shared item template for leaves. Column 0 is the check gutter (the Icon holds the check mark),
        column 1 is the label with the classic mnemonic underline, column 2 is the accelerator text.
        Hover fills the item with the highlight brush. Keyboard focus draws a 0.5 DIP (1 px) frame inside the
        item, as the classic popup does, and leaves the fill unchanged.
    -->
    <Style x:Key="BwcMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Height" Value="{StaticResource BwcMenuItemHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                        <Setter Target="Accelerator.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusFrame.BorderBrush" Value="{StaticResource BwcWindowTextBrush}" />
                                        <Setter Target="FocusFrame.BorderThickness" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="IconContent"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
                        <menu:MenuLabel
                            x:Name="Label"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Label="{TemplateBinding Text}"
                            MnemonicKey="{TemplateBinding AccessKey}" />
                        <TextBlock
                            x:Name="Accelerator"
                            Grid.Column="2"
                            Margin="0,0,22.5,0"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding KeyboardAcceleratorTextOverride}" />
                        <Border
                            x:Name="FocusFrame"
                            Grid.ColumnSpan="3"
                            Margin="3,0,3.5,0"
                            BorderThickness="0"
                            CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Toggle item (View > Address Bar). The same frame as a leaf, with a check glyph in the gutter that
        the CheckStates group shows when the item is checked. The glyph is in the 33 DIP gutter, so the
        label does not move when the check changes.
    -->
    <Style x:Key="BwcToggleMenuFlyoutItemStyle" TargetType="ToggleMenuFlyoutItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Height" Value="{StaticResource BwcMenuItemHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleMenuFlyoutItem">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                        <Setter Target="Accelerator.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckGlyph.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusFrame.BorderBrush" Value="{StaticResource BwcWindowTextBrush}" />
                                        <Setter Target="FocusFrame.BorderThickness" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="CheckGlyph"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Foreground="{TemplateBinding Foreground}"
                            Glyph="&#xE73E;"
                            Opacity="0" />
                        <menu:MenuLabel
                            x:Name="Label"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Label="{TemplateBinding Text}"
                            MnemonicKey="{TemplateBinding AccessKey}" />
                        <TextBlock
                            x:Name="Accelerator"
                            Grid.Column="2"
                            Margin="0,0,22.5,0"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding KeyboardAcceleratorTextOverride}" />
                        <Border
                            x:Name="FocusFrame"
                            Grid.ColumnSpan="3"
                            Margin="3,0,3.5,0"
                            BorderThickness="0"
                            CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Submenu item: the same frame as a leaf, with the chevron in place of the accelerator. -->
    <Style x:Key="BwcMenuFlyoutSubItemStyle" TargetType="MenuFlyoutSubItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Height" Value="{StaticResource BwcMenuItemHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutSubItem">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SubMenuOpened">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{StaticResource BwcMenuHighlightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                        <Setter Target="SubItemChevron.Foreground" Value="{StaticResource BwcGrayTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusFrame.BorderBrush" Value="{StaticResource BwcWindowTextBrush}" />
                                        <Setter Target="FocusFrame.BorderThickness" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="IconContent"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
                        <menu:MenuLabel
                            x:Name="Label"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Label="{TemplateBinding Text}"
                            MnemonicKey="{TemplateBinding AccessKey}" />
                        <TextBlock
                            x:Name="SubItemChevron"
                            Grid.Column="2"
                            Margin="0,0,13.5,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Foreground="{TemplateBinding Foreground}"
                            Text="&#xE76C;" />
                        <Border
                            x:Name="FocusFrame"
                            Grid.ColumnSpan="3"
                            Margin="3,0,3.5,0"
                            BorderThickness="0"
                            CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The separator is a 1 px line (0.5 DIP) 3 DIP from the top of a 6.5 DIP row, inset 6 DIP from each
        item edge. That matches the 13 px separator row with its line at row 6 in the oracle capture.
    -->
    <Style x:Key="BwcMenuFlyoutSeparatorStyle" TargetType="MenuFlyoutSeparator">
        <Setter Property="Height" Value="{StaticResource BwcMenuSeparatorHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutSeparator">
                    <Grid Background="Transparent" UseLayoutRounding="True">
                        <!-- 0.5 DIP is one physical pixel at 200 percent; layout rounding keeps it one pixel at other scales. -->
                        <Rectangle
                            Height="0.5"
                            Margin="6,3,6,0"
                            VerticalAlignment="Top"
                            Fill="{StaticResource BwcMenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Inline rename box in the tree and the value list. The template is the plain classic edit:
        an opaque window background, one pixel shadow border, no Fluent clear button, and no
        focus-state background change, so the row label can never show through the box.
    -->
    <Style x:Key="BwcInlineRenameTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BwcWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BwcShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border
                            x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Control.IsTemplateFocusTarget="True"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Margin="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Auto"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Auto"
                            ZoomMode="Disabled" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Address bar only. This is keyed so a normal TextBox in another view keeps its
        Fluent height and padding. The corner radius is 0, so the field is a flat rectangle as in the
        classic edit. The border and background brushes are set in ClassicWindowShell.
    -->
    <Style x:Key="BwcAddressBarTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource BwcMenuBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource BwcMenuBarHeight}" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="FontSize" Value="{StaticResource BwcFontSize}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource BwcShadowBrush}" />
        <Setter Property="Background" Value="{StaticResource BwcWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BwcWindowTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
