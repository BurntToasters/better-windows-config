<UserControl
    x:Class="Bwc.UI.List.DetailsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Bwc.UI.List"
    AutomationProperties.AutomationId="ListControl"
    AutomationProperties.Name="List"
    Background="Transparent"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <local:DetailsRowElement />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderHost"
            Grid.Row="0"
            Height="20"
            AutomationProperties.AutomationId="ListHeader"
            AutomationProperties.Name="List header"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid x:Name="HeaderClip">
                <local:DetailsHeaderPanel
                    x:Name="Header"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            AutomationProperties.AutomationId="ListBody">
            <ScrollViewer
                x:Name="Body"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                IsTabStop="False"
                Padding="0"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <Grid>
                    <controls:ItemsRepeater
                        x:Name="Repeater"
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource RowTemplate}"
                        VerticalAlignment="Top">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Vertical" Spacing="0" />
                        </controls:ItemsRepeater.Layout>
                    </controls:ItemsRepeater>

                    <Canvas
                        x:Name="Overlay"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <TextBox
                            x:Name="RenameBox"
                            AutomationProperties.AutomationId="ListRenameBox"
                            AutomationProperties.Name="Rename value"
                            AcceptsReturn="False"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            Style="{StaticResource BwcInlineRenameTextBoxStyle}"
                            TextWrapping="NoWrap"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
