<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Bwc.WinUIApp.props" />

  <PropertyGroup>
    <RootNamespace>Bwc.Regedit.App</RootNamespace>
    <AssemblyName>BwcRegedit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The E2E flavor never elevates. Ship keeps app.manifest (highestAvailable). -->
  <PropertyGroup Condition="'$(BwcFlavor)' == 'E2E'">
    <ApplicationManifest>app.e2e.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The apphost and merged manifest in obj are shared by both flavors. The SDK does not rebuild them
    when only the manifest selection changes, so an E2E build could leave asInvoker in ship. Drop them
    when the flavor changes.
  -->
  <Target Name="BwcDropFlavorManifestOutputs" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BwcFlavorStampFile>$(IntermediateOutputPath)bwc-flavor.txt</BwcFlavorStampFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BwcFlavorStampFile)" Condition="Exists('$(BwcFlavorStampFile)')">
      <Output TaskParameter="Lines" PropertyName="BwcPreviousFlavor" />
    </ReadLinesFromFile>
    <RemoveDir Directories="$(IntermediateOutputPath)Manifests" Condition="'$(BwcPreviousFlavor)' != '$(BwcFlavor)'" />
    <Delete Files="$(IntermediateOutputPath)apphost.exe" Condition="'$(BwcPreviousFlavor)' != '$(BwcFlavor)'" />
    <WriteLinesToFile File="$(BwcFlavorStampFile)" Lines="$(BwcFlavor)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bwc.Core\Bwc.Core.csproj" />
    <ProjectReference Include="..\Bwc.UI\Bwc.UI.csproj" />
    <ProjectReference Include="..\Bwc.Regedit\Bwc.Regedit.csproj" />
  </ItemGroup>

</Project>
