<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local GPO engine. No UI: no WinUI, no Bwc.UI, no Windows App SDK (docs/failure-modes/gpedit-scaffold.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bwc.Gpo</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The protected folder rules of the updater's elevated helper, linked by source so the rules stay one source. The data root
       helper and the template import store use them; Bwc.Policy sees the type through its reference to this project, so each
       dependency chain holds one compiled copy (docs/failure-modes/template-store.md, F3). -->
  <ItemGroup>
    <Compile Include="..\Bwc.Update\Helper\ProtectedAcl.cs" Link="Store\ProtectedAcl.cs" />
  </ItemGroup>

</Project>
