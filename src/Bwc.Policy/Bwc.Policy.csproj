<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADMX and policy state engine. No UI: no WinUI, no Bwc.UI, no Windows App SDK (docs/failure-modes/gpedit-scaffold.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bwc.Policy</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bwc.Gpo\Bwc.Gpo.csproj" />
  </ItemGroup>

  <!-- The import store uses the updater's protected folder rules, linked by source (docs/failure-modes/template-store.md, F3). -->
  <ItemGroup>
    <Compile Include="..\Bwc.Update\Helper\ProtectedAcl.cs" Link="Store\ProtectedAcl.cs" />
  </ItemGroup>

</Project>
